<Project>

  <PropertyGroup>
    <!-- The one place the product version is declared. Release builds override
         it from the git tag: dotnet publish -p:Version=1.0.0 -->
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">local</SourceRevisionId>
    <Product>Vora Media Server</Product>
    <Company>Vora</Company>
  </PropertyGroup>

</Project>
