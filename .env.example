# Copy this file to `.env` and adjust values for your environment.
# `.env` is loaded automatically by docker-compose; the bare variables
# below are referenced from docker-compose.yml as ${VAR:-default}.

# ===== Runtime user (PUID/PGID) =====
# The container drops root and runs the app as this user, then chowns
# the /app/data and /transcode mounts to match so bind mounts are
# writable regardless of host ownership (Plex/Jellyfin/LinuxServer
# pattern). Library mounts under /media are never chowned. Defaults are
# Unraid's nobody:users (99:100); set to your own `id -u`/`id -g` on
# other hosts.
PUID=99
PGID=100

# ===== Environment =====
# Development by default so local debugging picks up User Secrets.
# Override to Production when building a release image.
ASPNETCORE_ENVIRONMENT=Development

# ===== Database =====
# Postgres connection string (with vector extension installed in the target db).
DB_CONNECTION_STRING=Host=db;Port=5432;Database=vora;Username=vora;Password=changeme;Include Error Detail=true

# ===== Host port =====
# Port exposed by the API container on the host.
Vora_PORT=8080

# ===== Media library mounts =====
# Point these at the folders on the host that hold your media. The container
# always sees them at /media/movies, /media/shows, /media/music.
# Defaults in docker-compose.yml point at D:\TestServer\Movies/Shows/Music —
# override here if your media lives elsewhere.
MEDIA_MOVIES=D:\TestServer\Movies
MEDIA_SHOWS=D:\TestServer\Shows
MEDIA_MUSIC=D:\TestServer\Music

# ===== Vora persistent state =====
# Keep these on persistent storage; the container will write here.
# VORA_DATA hosts custom artwork, logs, backups, DataProtection keys,
# IPTV cache, recordings, user images, plugins, and thumbnails.
VORA_DATA=./Vora-data
VORA_TRANSCODE=./Vora-transcode
